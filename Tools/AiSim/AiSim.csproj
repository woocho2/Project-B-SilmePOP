<Project Sdk="Microsoft.NET.Sdk">
  <!-- AI 시뮬레이션 (Unity 없이). 실행 방법과 모드는 CLAUDE.md 참고 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <NoWarn>CS0067</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <Src>$(MSBuildThisFileDirectory)..\..\Assets\3. Scripts\</Src>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Src)00. Core\GameEnums.cs;$(Src)00. Core\GameRandom.cs;$(Src)00. Core\GameRules.cs;$(Src)01. Data\MatchSettings.cs" />
    <Compile Include="$(Src)02. Board\*.cs;$(Src)06. Skill\SkillBase.cs;$(Src)06. Skill\SkillSet.cs" />
    <Compile Include="$(Src)07. AI\AiAgent.cs;$(Src)07. AI\AiBrain.cs;$(Src)07. AI\AiDifficultyTable.cs;$(Src)07. AI\AiSkillAdvisor.cs;$(Src)07. AI\AiStrategy.cs" />
  </ItemGroup>
</Project>
